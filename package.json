{
  "name": "@workast/sdk",
  "version": "3.2.0",
  "description": "Workast SDK for JavaScript in the browser and Node.js",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./mock": {
      "import": {
        "types": "./dist/mock.d.ts",
        "default": "./dist/mock.js"
      },
      "require": {
        "types": "./dist/mock.d.cts",
        "default": "./dist/mock.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "tsup",
    "generate:types": "node scripts/generate-types.mjs",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workast/sdk.git"
  },
  "keywords": [
    "workast",
    "project management",
    "api"
  ],
  "author": "Workast <support@workast.com> (http://workast.com/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/workast/sdk/issues"
  },
  "homepage": "https://github.com/workast/sdk#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "openapi-format": "^1.33.6",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
